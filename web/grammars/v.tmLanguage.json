{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "v",
  "scopeName": "source.v",
  "patterns": [
    { "include": "#comment" },
    { "include": "#attribute" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#rune" },
    { "include": "#number" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#type" },
    { "include": "#label" },
    { "include": "#call" },
    { "include": "#usertype" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.double-slash.v", "match": "//.*$" },
        { "name": "comment.block.v", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "attribute": {
      "name": "meta.attribute.v",
      "begin": "@?\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.attribute.v" } },
      "endCaptures": { "0": { "name": "punctuation.definition.attribute.v" } },
      "patterns": [
        { "name": "entity.other.attribute-name.v", "match": "[A-Za-z_][A-Za-z0-9_]*" },
        { "include": "#string" }
      ]
    },
    "string": {
      "name": "string.quoted.single.v",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.v", "match": "\\\\." },
        {
          "name": "meta.interpolation.v",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.v" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.v" } },
          "patterns": [
            { "include": "#keyword" },
            { "include": "#constant" },
            { "include": "#number" },
            { "include": "#call" },
            { "include": "#usertype" },
            { "name": "variable.other.v", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        },
        { "name": "meta.interpolation.v", "match": "\\$[A-Za-z_][A-Za-z0-9_.]*" }
      ]
    },
    "char": {
      "name": "string.quoted.double.v",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.v", "match": "\\\\." }]
    },
    "rune": {
      "name": "string.quoted.other.rune.v",
      "match": "`(\\\\.|[^`\\\\])`"
    },
    "number": {
      "name": "constant.numeric.v",
      "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?)\\b"
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(struct|enum|union|interface|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.v" },
            "2": { "name": "entity.name.type.v" }
          }
        },
        {
          "match": "\\b(module|import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.v" },
            "2": { "name": "entity.name.namespace.v" }
          }
        }
      ]
    },
    "keyword": {
      "name": "keyword.control.v",
      "match": "\\b(as|assert|atomic|break|const|continue|defer|else|enum|fn|for|go|goto|if|import|in|interface|is|lock|match|module|mut|none|or|pub|return|rlock|select|shared|spawn|struct|type|union|unsafe|__global)\\b"
    },
    "constant": {
      "name": "constant.language.v",
      "match": "\\b(true|false|nil|none|err)\\b"
    },
    "type": {
      "name": "storage.type.v",
      "match": "\\b(bool|string|rune|byte|voidptr|byteptr|charptr|isize|usize|size_t|any|i8|i16|i32|i64|int|u8|u16|u32|u64|f32|f64)\\b"
    },
    "label": {
      "match": "^\\s*(mut|pub|mut pub|pub mut|__global)\\s*:",
      "captures": { "1": { "name": "keyword.control.v" } }
    },
    "call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.call.v"
    },
    "usertype": {
      "name": "entity.name.type.v",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operator": {
      "name": "keyword.operator.v",
      "match": ":=|[-+*/%!<>=&|^]=?|\\?|\\.\\.\\.?|<-"
    }
  }
}
