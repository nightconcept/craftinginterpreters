---
import "../styles/book.scss";
import BookNav from "../components/BookNav.astro";
import { adjacent, chapterNumber, titleFor, parts } from "../data/toc";

interface Heading { depth: number; slug: string; text: string }
interface Props { slug: string; headings?: Heading[] }
const { slug, headings = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (s: string) => `${base}${s === "index" ? "" : `${s}/`}`.replace(/\/{2,}/g, "/");

// A page whose slug names a part is a part-divider page, not a chapter.
const roman = ["I", "II", "III", "IV", "V"];
const titledParts = parts.filter((p) => p.title !== "");
const partIndex = titledParts.findIndex((p) => p.slug === slug);
const isPart = partIndex !== -1;
const partLabel = isPart
  ? (titledParts[partIndex].title === "Backmatter" ? "❧" : roman[partIndex] ?? "")
  : "";

const title = isPart ? titledParts[partIndex].title : titleFor(slug);
const number = isPart ? "" : chapterNumber(slug);
const { prev, next } = adjacent(slug);

// The contents page has no asides, so let it use the full content width.
const isContents = slug === "contents";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} &middot; Crafting Interpreters in V</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600&family=Source+Code+Pro:wght@400;600&display=swap"
    />
    <style is:global set:html={`
      @font-face { font-family: "Crimson"; font-weight: 400; font-display: swap;
        src: url("${base}font/crimson-roman.woff") format("woff"); }
      @font-face { font-family: "Crimson"; font-weight: 400; font-style: italic; font-display: swap;
        src: url("${base}font/crimson-italic.woff") format("woff"); }
      @font-face { font-family: "Crimson"; font-weight: 600; font-display: swap;
        src: url("${base}font/crimson-semibold.woff") format("woff"); }
      @font-face { font-family: "Crimson"; font-weight: 600; font-style: italic; font-display: swap;
        src: url("${base}font/crimson-semibolditalic.woff") format("woff"); }
      @font-face { font-family: "Crimson"; font-weight: 700; font-display: swap;
        src: url("${base}font/crimson-bold.woff") format("woff"); }
      @font-face { font-family: "Crimson"; font-weight: 700; font-style: italic; font-display: swap;
        src: url("${base}font/crimson-bolditalic.woff") format("woff"); }
    `} />
  </head>
  <body>
    <nav class="wide">
      <a class="logo" href={href("index")}>Crafting Interpreters <span>in V</span></a>
      <BookNav slug={slug} headings={headings} />
    </nav>

    <div class:list={["page", isContents && "wide-page"]}>
      <details class="floating">
        <summary>
          <span class="logo">Crafting Interpreters <span>in V</span></span>
          <span class="toggle">Contents</span>
        </summary>
        <BookNav slug={slug} headings={headings} />
      </details>

      <article class:list={["prose", isPart && "is-part", isContents && "full"]}>
        {isPart
          ? <div class="part-number"><span>Part </span>{partLabel}</div>
          : number && <div class="chapter-number"><span>Chapter </span>{number}</div>}
        <h1 class:list={[isPart && "part"]}>{title}</h1>
        <slot />

        <footer class="chapter-nav">
          {prev ? <a href={href(prev.slug)}>&larr; {prev.title}</a> : <span />}
          {next ? <a href={href(next.slug)}>{next.title} &rarr;</a> : <span />}
        </footer>
      </article>
    </div>

    <script>
      // Line each aside up with the anchor that names it. Asides live inside
      // the prose article and CSS makes them absolute on wide screens, so the
      // prose box is the reference frame for every offset here.
      function placeAsides() {
        const prose = document.querySelector(".prose");
        if (!prose) return;

        const wide = window.matchMedia("(min-width: 1200px)").matches;
        const asides = document.querySelectorAll<HTMLElement>(".aside");
        if (!wide) {
          asides.forEach((a) => (a.style.top = ""));
          return;
        }

        const top = prose.getBoundingClientRect().top;
        // Natural y of each aside, read before any `top` is applied, so an
        // aside with no matching anchor still lands near where it was written.
        const natural = new Map<HTMLElement, number>();
        asides.forEach((a) => natural.set(a, a.getBoundingClientRect().top - top));

        let floor = 0;
        asides.forEach((aside) => {
          const anchor = document.querySelector(`[data-anchor="${aside.dataset.aside}"]`);
          const want = anchor
            ? anchor.getBoundingClientRect().top - top
            : natural.get(aside)!;
          // Never let an aside overlap the one above it.
          const at = Math.max(want, floor);
          aside.style.top = `${at}px`;
          floor = at + aside.offsetHeight + 24;
        });
      }

      placeAsides();
      window.addEventListener("resize", placeAsides);
      document.fonts?.ready.then(placeAsides);
    </script>
  </body>
</html>
