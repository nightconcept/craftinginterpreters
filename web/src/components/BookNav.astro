---
import { parts, chapterNumber } from "../data/toc";

interface Heading { depth: number; slug: string; text: string }
interface Props { slug: string; headings?: Heading[] }
const { slug, headings = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (s: string) => `${base}${s === "index" ? "" : `${s}/`}`.replace(/\/{2,}/g, "/");

// Parts with a title are numbered I, II, III; Backmatter gets a fleuron.
const roman = ["I", "II", "III", "IV", "V"];
let numberedPart = 0;
const label = (title: string) => {
  if (title === "Backmatter") return "";
  return roman[numberedPart++] ?? "";
};

const sections = headings.filter((h) => h.depth === 2);
---

<div class="contents">
  {parts.map((part) => (
    part.title === "" ? (
      <ul class="frontmatter">
        {part.chapters.map((ch) => (
          <li class={ch.slug === slug ? "current" : undefined}>
            <a href={href(ch.slug)}>{ch.title}</a>
          </li>
        ))}
      </ul>
    ) : (
      <section>
        <h2><small>{label(part.title)}</small>{part.title}</h2>
        <ul>
          {part.chapters.map((ch) => (
            <li class={ch.slug === slug ? "current" : undefined}>
              <a href={href(ch.slug)}>
                <small>{chapterNumber(ch.slug)}</small>{ch.title}
              </a>
              {ch.slug === slug && sections.length > 0 && (
                <ul class="sections">
                  {sections.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  ))}
</div>
